# SmartWater V1 deployment environment template.
# Copy this file to deploy/.env and replace every placeholder before starting.

COMPOSE_PROJECT_NAME=smartwater

# Published ports
FRONTEND_PORT=80
JAVA_BACKEND_PORT=8080
PYTHON_AI_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# MySQL
MYSQL_DATABASE=smartwater
MYSQL_USER=smartwater
MYSQL_PASSWORD=replace-with-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# Redis is part of the CP4 topology and is reserved for later session/cache wiring.
REDIS_PASSWORD=replace-with-strong-redis-password

# RustFS / S3-compatible object storage
RUSTFS_ACCESS_KEY=replace-with-rustfs-access-key
RUSTFS_SECRET_KEY=replace-with-rustfs-secret-key
S3_BUCKET=smartwater
S3_REGION=us-east-1

# Java <-> Python internal auth. Use the same value on both sides.
WORKER_TOKEN=replace-with-worker-token
INTERNAL_API_TOKEN=replace-with-internal-api-token

# Java AI service configuration
AI_SERVICE_BASE_URL=http://python-ai:8000
AI_SERVICE_HEALTH_PATH=/health
AI_SERVICE_TIMEOUT=10s
AI_SERVICE_MCP_TRANSPORT=streamable-http
AI_SERVICE_MCP_PATH=/mcp
AI_SERVICE_MCP_KNOWLEDGE_SEARCH_PATH=/api/mcp/tools/knowledge_search
AI_SERVICE_MCP_CHECK_COMPLETENESS_PATH=/api/mcp/tools/check_completeness
AI_REVIEW_TASK_DISPATCH_ENABLED=true
AI_REVIEW_TASK_PATH=/api/review/tasks
AI_REVIEW_TASK_MAX_ATTEMPTS=3
AI_INGEST_WORKDIR=/app
AI_INGEST_SOURCE_DIR=/app/knowledge_source
AI_INGEST_CHUNK_SIZE=512
AI_INGEST_CHUNK_OVERLAP=64
AI_INGEST_REBUILD=false

# Python AI service
BACKEND_API_BASE=http://java-backend:8080/api
OCR_PROVIDER=glm
OCR_GLM_API_KEY=replace-with-glm-ocr-api-key
OCR_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
REVIEW_LLM_PROVIDER=dashscope
REVIEW_LLM_MODEL=qwen-max
REVIEW_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REVIEW_LLM_API_KEY=replace-with-review-llm-api-key
WORKER_POLL_INTERVAL=5
WORKER_MAX_RETRIES=3
KNOWLEDGE_PACK_DIR=/app/knowledge_pack
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-embedding-api-key
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION_NAME=knowledge_base
KNOWLEDGE_SOURCE_DIR=/app/knowledge_source
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SOFFICE_PATH=/usr/bin/soffice
LOG_LEVEL=INFO
