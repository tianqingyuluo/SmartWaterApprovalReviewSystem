# SmartWater 敏感配置文件
# 此文件包含密码、密钥等敏感信息，不应提交到 Git
# 请复制 application-secrets.yaml.example 并重命名为 application-secrets.yaml

spring:
  datasource:
    password: your-mysql-password-here

storage:
  s3:
    access-key: your-s3-access-key-here
    secret-key: your-s3-secret-key-here

water-approval:
  ai-service:
    internal-token: your-ai-service-internal-token-here
    review-task:
      enabled: true
