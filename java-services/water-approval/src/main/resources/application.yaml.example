# SmartWater 应用配置模板
# 复制此文件为 application.yaml，按需修改数据库、存储等配置
# 敏感信息（密码、密钥）放在 application-secrets.yaml 中
# 各环境差异通过环境变量覆盖，默认值适用于本地开发

spring:
  application:
    name: water-approval
  config:
    # 从 application-secrets.yaml 导入数据库密码、S3 密钥等
    import: optional:classpath:application-secrets.yaml
  datasource:
    url: jdbc:mysql://${MYSQL_HOST:localhost}:${MYSQL_PORT:3306}/${MYSQL_DATABASE:smartwater}?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: ${MYSQL_USER:root}
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 5
      connection-timeout: 30000
  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 100MB

mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  type-aliases-package: com.tianqingyuluo.waterapproval.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0
      id-type: assign_id

storage:
  s3:
    endpoint: ${S3_ENDPOINT:http://localhost:9000}
    bucket-name: ${S3_BUCKET:smartwater}
    region: ${S3_REGION:us-east-1}

water-approval:
  worker:
    # Worker API 鉴权令牌，生产环境必须设置，本地开发可留空
    token: ${WORKER_TOKEN:}
  ai-service:
    # Python AI/MCP 服务地址。当前 Python MCP 支持 stdio/sse/streamable-http transport。
    base-url: ${AI_SERVICE_BASE_URL:http://localhost:8000}
    health-path: ${AI_SERVICE_HEALTH_PATH:/health}
    # Java 探活 Python HTTP 适配服务时携带的内部令牌；未配置时不发送。
    internal-token: ${AI_SERVICE_INTERNAL_TOKEN:}
    timeout: ${AI_SERVICE_TIMEOUT:3s}
    mcp-transport: ${AI_SERVICE_MCP_TRANSPORT:streamable-http}
    mcp-path: ${AI_SERVICE_MCP_PATH:/mcp}
    ingest:
      # 当前 Python 提供 ingest CLI；Java /ai/ingest 输出运维触发命令，不在 Java 进程内执行。
      workdir: ${AI_INGEST_WORKDIR:../../python-services/smart-water-approval-review-system-py}
      source-dir: ${AI_INGEST_SOURCE_DIR:../../docs/参考资料}
      chunk-size: ${AI_INGEST_CHUNK_SIZE:512}
      chunk-overlap: ${AI_INGEST_CHUNK_OVERLAP:64}
      rebuild: ${AI_INGEST_REBUILD:false}

server:
  port: 8080
  servlet:
    context-path: /api

logging:
  level:
    com.tianqingyuluo.waterapproval: INFO

sa-token:
  token-name: Authorization
  token-prefix: Bearer
  timeout: 604800
  active-timeout: -1
  is-concurrent: true
  is-share: true
  token-style: uuid
  is-read-header: true
  is-read-cookie: false
  is-read-body: false
  is-read-param: false
