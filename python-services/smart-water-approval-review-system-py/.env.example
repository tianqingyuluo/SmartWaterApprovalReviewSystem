# SmartWater Python AI Service 环境变量配置
# 复制此文件为 .env 并填入实际值

# 后端服务地址
BACKEND_API_BASE=http://localhost:8080/api
WORKER_TOKEN=your-worker-token-here
INTERNAL_API_TOKEN=

# OCR 配置 (GLM OCR layout_parsing；Base URL 保持到 /v4，Worker 会追加 /layout_parsing)
OCR_PROVIDER=glm
OCR_GLM_API_KEY=your-glm-api-key
OCR_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 审核推理模型配置
REVIEW_LLM_PROVIDER=dashscope
REVIEW_LLM_MODEL=qwen-max
REVIEW_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REVIEW_LLM_API_KEY=your-dashscope-api-key

# Worker 配置
WORKER_POLL_INTERVAL=5
WORKER_MAX_RETRIES=3

# 知识包目录
KNOWLEDGE_PACK_DIR=./knowledge_pack

# Embedding 配置 (V1 CP2)
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-embedding-api-key

# ChromaDB 配置 (V1 CP2)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=knowledge_base

# 知识库源文档目录 (V1 CP2)
KNOWLEDGE_SOURCE_DIR=./knowledge_source

# 文本切分配置 (V1 CP2)
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# LibreOffice 路径 (旧版 .doc 转换)
# SOFFICE_PATH=/usr/bin/soffice

# 日志级别
LOG_LEVEL=INFO
